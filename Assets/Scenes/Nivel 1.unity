    objetoIndicador: {fileID: 0}
    tiempo: 0.5
    puntoA: {fileID: 0}
    puntoB: {fileID: 0}
    tiempoEsperaEnDestino: 1.5
  - tipoDePaso: 1
    mensaje: 
