    objetoIndicador: {fileID: 314221745}
    tiempo: 1
    puntoA: {fileID: 0}
    puntoB: {fileID: 0}
    tiempoEsperaEnDestino: 1.5
  - tipoDePaso: 1
    mensaje: 
