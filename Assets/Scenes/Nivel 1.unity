    puntoA: {fileID: 0}
    puntoB: {fileID: 0}
    tiempoEsperaEnDestino: 1.5
  - tipoDePaso: 0
    mensaje: "\xA1Gusto en conocerte! Soy ROBIT :D"
    expresionPersonaje: 1
    objetoIndicador: {fileID: 0}
    tiempo: 2
    puntoA: {fileID: 0}
    puntoB: {fileID: 0}
    tiempoEsperaEnDestino: 1.5
  - tipoDePaso: 0
    mensaje: "Necesito de tu ayuda \xA1Mi programaci\xF3n se borr\xF3!\nY necesito
      volver a mi casita..."
    expresionPersonaje: 2
    objetoIndicador: {fileID: 0}
    tiempo: 2
    puntoA: {fileID: 0}
    puntoB: {fileID: 0}
    tiempoEsperaEnDestino: 1.5
  - tipoDePaso: 0
    mensaje: "Solo debes agarrar este bloque que te se\xF1alo ac\xE1..."
