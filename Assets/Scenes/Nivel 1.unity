    tiempo: 1
    puntoA: {fileID: 0}
    puntoB: {fileID: 0}
    tiempoEsperaEnDestino: 1.5
  - tipoDePaso: 0
    mensaje: "Y colocarlo ac\xE1..."
    expresionPersonaje: 1
    objetoIndicador: {fileID: 314221745}
    tiempo: 2
    puntoA: {fileID: 0}
    puntoB: {fileID: 0}
    tiempoEsperaEnDestino: 1.5
  - tipoDePaso: 2
    mensaje: "Y colocarlo ac\xE1..."
