    expresionPersonaje: 1
    objetoIndicador: {fileID: 2069578853}
    tiempo: 2
    puntoA: {fileID: 0}
    puntoB: {fileID: 0}
    tiempoEsperaEnDestino: 1.5
  - tipoDePaso: 2
    mensaje: "Int\xE9ntalo, luego presionas el bot\xF3n verde arriba a la derecha
      para iniciar la programaci\xF3n."
    expresionPersonaje: 1
