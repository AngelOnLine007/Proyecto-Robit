  gestionDialogos: {fileID: 2031606077}
  pasosDelTutorial:
  - tipoDePaso: 0
    mensaje: "\xBFCharcos y cables?..."
    expresionPersonaje: 3
    objetoIndicador: {fileID: 0}
    tiempo: 2
    puntoA: {fileID: 0}
    puntoB: {fileID: 0}
    tiempoEsperaEnDestino: 1.5
  - tipoDePaso: 0
    mensaje: "Me podr\xE9 da\xF1ar si toco alguno. u.u "
    expresionPersonaje: 2
    objetoIndicador: {fileID: 0}
    tiempo: 2
    puntoA: {fileID: 0}
    puntoB: {fileID: 0}
    tiempoEsperaEnDestino: 1.5
  - tipoDePaso: 0
    mensaje: "Mi sistema de seguridad me detendr\xE1 si el pr\xF3ximo bloque me lleva
      hacia un cable o un charco, \xA1As\xED que no te preocupes por mi!"
    expresionPersonaje: 3
    objetoIndicador: {fileID: 0}
    tiempo: 2
    puntoA: {fileID: 0}
    puntoB: {fileID: 0}
    tiempoEsperaEnDestino: 1.5
  - tipoDePaso: 0
    mensaje: "Estar\xE9 bien, pero trata de esquivar el charco y los cables para
      estar seguros \xBFDe acuerdo?"
    expresionPersonaje: 3
    objetoIndicador: {fileID: 0}
    tiempo: 2
    puntoA: {fileID: 0}
    puntoB: {fileID: 0}
    tiempoEsperaEnDestino: 1.5
  - tipoDePaso: 0
    mensaje: Sigamos avanzando, vamos al siguiente portal :D
    expresionPersonaje: 1
    objetoIndicador: {fileID: 0}
    tiempo: 2
    puntoA: {fileID: 0}
    puntoB: {fileID: 0}
    tiempoEsperaEnDestino: 1.5
